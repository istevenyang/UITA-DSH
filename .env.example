# ============================================================================
# UITA-DSH 环境变量示例（复制为 .env.local 或导出到系统环境变量）
# ============================================================================

# 1. 全局统一 LLM / 视觉模型配置（DSH 规划器、L6/L8 视觉定位与判定、性能分析共用）
DSH_API_URL=https://api.example.com/v1/chat/completions
DSH_API_KEY=sk-your-api-key-here

# 2. DSH 模型与服务参数
UITA_DSH_MODEL=default-model
UITA_DSH_MODEL_FALLBACKS=default-model,fallback-model
UITA_DSH_PORT=8765
UITA_DSH_MODE=supervised

# 3. 框架核心参数
UITA_LOG_LEVEL=INFO
UITA_USE_LOCAL_ROSETTA=1

# 4. 元素与路由远端数据库存储扩展（可选，仅提供接口契约；设为 0 并指定实现类后生效，失败自动回退本地 JSON）
# UITA_USE_LOCAL_ROSETTA=0
# UITA_REMOTE_DB_URL=mysql+pymysql://user:password@db.example.com:3306/uita_rosetta
# UITA_ROSETTA_STORE_CLASS=my_project.rosetta_db:MyDbRosettaStore
# UITA_ROUTER_PROXY_STORE_CLASS=my_project.rosetta_db:MyDbRouterProxyStore

# 5. Windows UIA 窗口后端灰度开关（uiautomation 默认 | pywinauto 灰度）
UIA_WIN_BACKEND=uiautomation
UIA_WINDOW_HINT_STRICT=0
UIA_WINDOW_HINT_WAIT_S=1.5
